# ============================================================================
# JKR AI Calling — environment configuration
# Copy to .env and fill in as needed. Nothing here is required to run the
# local demo — every provider defaults to a mock adapter and no real call is
# ever placed unless ENABLE_LIVE_CALLS=true is set explicitly (see below).
# ============================================================================

# --- Core -------------------------------------------------------------------
APP_ENV=local                      # local | staging | production
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
VOICE_WORKER_BASE_URL=http://localhost:8100
LOG_LEVEL=info
LOG_FORMAT=json

# --- Database -----------------------------------------------------------
# NOTE: host-mapped ports are 55432/16379, not the 5432/6379 defaults, because
# this machine may already run native Postgres/Redis on the standard ports —
# see docker-compose.yml comments. Containers still talk to each other over
# the standard ports via service DNS names (postgres:5432, redis:6379).
#
# Two DB roles, on purpose (docs/DECISIONS/0004-tenant-isolation.md): POSTGRES_USER
# is the bootstrap superuser, used only for migrations (DDL, creating RLS
# policies) — it BYPASSES RLS, so it must never be the role application
# services connect as. APP_DB_USER is the non-superuser, RLS-enforced role
# every service (api, voice-worker, the workers) actually connects as.
POSTGRES_USER=jkr
POSTGRES_PASSWORD=jkr_local_dev
POSTGRES_DB=jkr_ai_calling
APP_DB_USER=jkr_app
APP_DB_PASSWORD=jkr_app_local_dev

DATABASE_URL=postgresql+asyncpg://jkr_app:jkr_app_local_dev@localhost:55432/jkr_ai_calling
DATABASE_URL_SYNC=postgresql+psycopg://jkr_app:jkr_app_local_dev@localhost:55432/jkr_ai_calling
# Superuser connection string — migrations only (`make db-upgrade` etc.).
# Never read by services/api, voice-worker, or any of the workers.
MIGRATIONS_DATABASE_URL_SYNC=postgresql+psycopg://jkr:jkr_local_dev@localhost:55432/jkr_ai_calling

# --- Redis (sessions, queues, locks, idempotency, rate limiting) -----------
REDIS_URL=redis://localhost:16379/0

# --- Object storage (S3-compatible / MinIO locally) -------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=jkr_minio
S3_SECRET_ACCESS_KEY=jkr_minio_local_dev
S3_BUCKET_RECORDINGS=jkr-recordings
S3_BUCKET_DOCUMENTS=jkr-documents
S3_BUCKET_EXPORTS=jkr-exports
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=true

# --- Auth / security ----------------------------------------------------
SESSION_SECRET=change_me_dev_only_session_secret
CSRF_SECRET=change_me_dev_only_csrf_secret
CREDENTIALS_ENCRYPTION_KEY=change_me_dev_only_fernet_key_44_bytes_base64
INTERNAL_SERVICE_TOKEN=change_me_dev_only_service_to_service_token
WEBHOOK_SIGNING_SECRET=change_me_dev_only_webhook_secret

# Google OAuth login — TODO: obtain real credentials before enabling.
# Left blank on purpose: the "Continue with Google" button stays disabled
# with an explanatory tooltip until both are set. See docs/DECISIONS/0006-auth.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/oauth/google/callback

# --- Outbound calling safety (spec §2 rules 19-20) ---------------------
# Both must be explicitly set for ANY real (non-mock) telephony dispatch.
# Mock-provider calls always run regardless of these — see
# docs/DECISIONS/0003-safety-gate-independent-of-dry-run.md. These also gate
# the separate "live real call" test path below (app/modules/live_call).
ENABLE_LIVE_CALLS=false
AUTHORIZED_TEST_NUMBERS=            # comma-separated E.164 numbers, e.g. +919876543210,+911234567890

# --- Live real-call test path (services/api/app/modules/live_call) --------
# A self-contained, additive "place one real call" flow — separate from the
# mock campaign/Test Lab pipeline. Twilio's own <Gather>/<Say> act as
# STT/TTS (no separate STT/TTS credentials needed for this path); a real LLM
# drives what's said, using the OPENAI_API_KEY / LLM_PROVIDER_DEFAULT and
# TWILIO_* / TELEPHONY_PROVIDER_DEFAULT vars further down this file. Needs
# ENABLE_LIVE_CALLS=true above, the destination number in
# AUTHORIZED_TEST_NUMBERS above, and PUBLIC_WEBHOOK_BASE_URL below reachable
# from the public internet (e.g. an ngrok https URL) so Twilio's servers can
# reach it.
PUBLIC_WEBHOOK_BASE_URL=            # e.g. https://xxxx.ngrok-free.app — falls back to API_BASE_URL (only useful if that's already public)

# --- Voice runtime (all optional — MockMediaRuntime is the default) --------
VOICE_RUNTIME_DEFAULT=mock          # mock | livekit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change_me_dev_only_livekit_secret

# --- STT providers (TODO: real credentials before enabling a non-mock STT) --
STT_PROVIDER_DEFAULT=mock           # mock | deepgram | sarvam | google
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
GOOGLE_STT_CREDENTIALS_JSON=

# --- LLM providers (mock rule-driven by default; real key enables real LLM) -
LLM_PROVIDER_DEFAULT=mock           # mock | openai | anthropic | google | local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_LLM_API_KEY=
LOCAL_LLM_BASE_URL=                 # OpenAI-compatible local endpoint, e.g. http://localhost:11434/v1

# --- TTS providers (TODO: real credentials before enabling a non-mock TTS) --
TTS_PROVIDER_DEFAULT=mock           # mock | elevenlabs | cartesia | sarvam | openai
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
SARVAM_TTS_API_KEY=
OPENAI_TTS_API_KEY=

# --- Telephony providers (TODO: real credentials + ENABLE_LIVE_CALLS=true) --
TELEPHONY_PROVIDER_DEFAULT=mock     # mock | twilio | sip_trunk
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SIP_TRUNK_HOST=
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=
# Placeholders only — no adapter logic ships for these yet, interfaces exist:
EXOTEL_API_KEY=
PLIVO_AUTH_ID=
TELNYX_API_KEY=

# --- Integrations (all TODO: real OAuth/app credentials) --------------------
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PROVIDER=mock              # mock | meta_cloud_api | gupshup | interakt
WHATSAPP_API_KEY=
N8N_WEBHOOK_BASE_URL=

# --- Observability (no-op locally unless set) --------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
PROMETHEUS_METRICS_PORT=9464

# --- Billing defaults ----------------------------------------------------
DEFAULT_WORKSPACE_DAILY_BUDGET_PAISE=500000     # ₹5,000/day default cap, per-workspace overridable
DEFAULT_WORKSPACE_MONTHLY_BUDGET_PAISE=10000000 # ₹1,00,000/month default cap

# --- Frontend-only public vars (exposed to the browser, no secrets) --------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=local
