# ==============================================================================
# JKR AI Calling - Environment Variables Template
# ==============================================================================

# --- LiveKit Cloud Credentials ---
# Found in LiveKit Cloud Console (https://cloud.livekit.io) -> Project Settings -> Keys
LIVEKIT_URL=wss://<your-project-subdomain>.livekit.cloud
LIVEKIT_API_KEY=<paste_livekit_api_key_here>
LIVEKIT_API_SECRET=<paste_livekit_api_secret_here>

# --- SIP Configuration ---
# Your LiveKit SIP URI (Found in LiveKit Cloud Console -> SIP tab)
# Format: <project-subdomain>.sip.livekit.cloud
LIVEKIT_SIP_ENDPOINT=<your-project-subdomain>.sip.livekit.cloud

# Optional: Outbound SIP Trunk ID if placing outbound calls from agent
LIVEKIT_SIP_OUTBOUND_TRUNK=<paste_sip_trunk_id_if_available>

# --- AI Providers ---
# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=<paste_openai_api_key_here>

# Sarvam AI API Key for STT (Saarika) & TTS (Bulbul) (https://dashboard.sarvam.ai)
SARVAM_API_KEY=<paste_sarvam_api_key_here>

# --- Twilio Credentials ---
# Found in Twilio Console Dashboard (https://console.twilio.com)
TWILIO_ACCOUNT_SID=<paste_twilio_account_sid_here>
TWILIO_AUTH_TOKEN=<paste_twilio_auth_token_here>
TWILIO_PHONE_NUMBER=<paste_your_twilio_phone_number_here_e164_format>
